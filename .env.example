# mock = 시뮬레이터 데이터 사용, hyundai = 현대 Developers Open API 사용
VITE_DATA_SOURCE=mock
# 현대 Developers에서 발급받은 값 (실제 키는 .env.local 에만 넣고 커밋하지 마세요)
VITE_HYUNDAI_CLIENT_ID=
VITE_HYUNDAI_REDIRECT_URI=http://localhost:5173/callback
VITE_HYUNDAI_API_BASE=https://dev.kr-ccapi.hyundai.com

# 아이 목소리 (Typecast 무료 플랜: typecast.ai → API Console → API Key)
# 서버에서만 사용 (VITE_ 접두사 없음). 비워 두면 브라우저 기본 목소리
TYPECAST_API_KEY=
# 선택: 특정 목소리 고정 (비우면 '아이' 한국어 목소리 자동 선택)
TYPECAST_VOICE_ID=
TTS_DAILY_LIMIT=200

# 대화 AI + 사람 같은 목소리 (Google AI Studio → Get API key, 무료). 서버 전용
GEMINI_API_KEY=

# ── 보안 (SECURITY.md 참고) ── 모두 서버 전용, Vercel 대시보드에 넣으세요
# 세션 쿠키 암호화 키: 32바이트 이상 무작위 값
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# 현대 Developers 클라이언트 비밀키와 콜백 주소 (예: https://<도메인>/callback)
HYUNDAI_CLIENT_SECRET=
HYUNDAI_REDIRECT_URI=
# 현대 인증 서버가 PKCE를 지원하면 1
HYUNDAI_PKCE=
