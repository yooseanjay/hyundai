<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- Pleos Vehicle SDK: 읽기만 (차를 제어하는 권한 없음) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- 누적 주행거리 · 주행 가능 거리 · 기어 -->
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />  <!-- 배터리 % · 연료 % · 충전 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />  <!-- 엔진오일 · 브레이크액 · 워셔액 -->
    <!-- Pleos TextToSpeech: 캐릭터 목소리 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OurCar">
        <!--
          distractionOptimized: 주행 중에도 화면을 띄우되, 앱이 CarUxRestrictions 를 받아
          '주행 중 화면'(큰 얼굴 + 주행 가능 거리만, 터치 최소)으로 바꾼다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <uses-library android:name="android.car" android:required="false" />
    </application>
</manifest>
